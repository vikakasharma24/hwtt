# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure for your production server
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# MySQL Database Credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DB=jh_health_db

# Cryptographic Salt for Passwords
PASSWORD_SALT=JH_HEALTH_PORTAL_SALT_v1

# Optional: Google Apps Script Webhook URL for background backup
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyWrPzgeQi2IuxA-0ibEjTzS1ravrl66TdC8OAsxfdVYcAKCmpC95xaHmnpF7mzUcmK/exec
