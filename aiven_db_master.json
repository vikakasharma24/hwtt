      "assessments_json": "{\"pre\": [{\"type\": \"MCQ\", \"text\": \"What is the standard recommended storage temperature range for vaccines in Ice-Lined Refrigerators (ILR)?\", \"marks\": 1, \"options\": [\"-20\\u00b0C to -10\\u00b0C\", \"+2\\u00b0C to +8\\u00b0C\", \"+15\\u00b0C to +25\\u00b0C\", \"Sub-zero freezing\"], \"correct\": 1}, {\"type\": \"TF\", \"text\": \"The shake test is used to detect if freeze-sensitive vaccines (e.g. Pentavalent, Td, Hepatitis B) have suffered freezing damage.\", \"marks\": 1, \"correct\": true}], \"post\": [{\"type\": \"MCQ\", \"text\": \"What is the emergency first-line drug and route for managing acute anaphylaxis at a vaccination session site?\", \"marks\": 1, \"options\": [\"Oral paracetamol\", \"Adrenaline (1:1000 dilution) Intramuscular (IM) in anterolateral thigh\", \"Oral antibiotics\", \"Topical antiseptic\"], \"correct\": 1}, {\"type\": \"TF\", \"text\": \"Vaccine vials displaying Stage 3 or Stage 4 Vaccine Vial Monitor (VVM) square darker than outer circle must be discarded.\", \"marks\": 1, \"correct\": true}]}",
