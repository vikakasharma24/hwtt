      "assessments_json": "{\"pre\": [{\"type\": \"MCQ\", \"text\": \"What is the minimum recommended number of Antenatal Care (ANC) checkups during pregnancy?\", \"marks\": 1, \"options\": [\"1\", \"2\", \"4\", \"6\"], \"correct\": 2}, {\"type\": \"TF\", \"text\": \"Iron and Folic Acid (IFA) supplementation is vital to prevent maternal anemia.\", \"marks\": 1, \"correct\": true}], \"post\": [{\"type\": \"MCQ\", \"text\": \"What is the first-line medication protocol for active management of third stage of labor / PPH?\", \"marks\": 1, \"options\": [\"Oxytocin (10 IU IM)\", \"Sedatives\", \"Antibiotics only\", \"No intervention\"], \"correct\": 0}, {\"type\": \"TF\", \"text\": \"Skin-to-skin Kangaroo Mother Care (KMC) significantly improves thermal stabilization in premature neonates.\", \"marks\": 1, \"correct\": true}]}",
